<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ECEFE8">
  <title>{% if title %}{{ title }} — {{ site.shortTitle }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  {%- if env.preview %}
  {# _headers only applies on Cloudflare Pages; this also covers the GitHub Pages mirror. #}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
  {% if tallyPopup %}
  <script>
    window.TallyConfig = {
      "formId": "5BllMv",
      "popup": {
        "autoClose": 5000,
        "formEventsForwarding": true,
        "open": {
          "trigger": "scroll",
          "scrollPercent": 25
        }
      }
    };
  </script>
  <script async src="https://tally.so/widgets/embed.js"></script>
  {% endif %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

  <svg class="brand-sprite" aria-hidden="true" focusable="false" width="0" height="0">
    <symbol id="ast" viewBox="0 0 1560.16 1568.69"><defs>
<clipPath id="ast_clip">
<path transform="matrix(1,0,0,-1,0,1568.69)" d="M0 1568.687H1560.159V0H0Z"/>
</clipPath>
</defs>
<g fill="currentColor">
<g inkscape:groupmode="layer" inkscape:label="Layer 1">
<g clip-path="url(#ast_clip)">
<path transform="matrix(1,0,0,-1,1551.4149,598.7036)" d="M0 0V0C-31.366 99.397-137.763 154.146-236.874 121.891L-562.186 16.022V411.168C-562.186 514.74-646.147 598.701-749.718 598.701H-792.952C-896.523 598.701-980.484 514.74-980.484 411.168V16.022L-1305.796 121.891C-1404.908 154.146-1511.304 99.397-1542.67 0-1573.953-99.131-1518.634-204.793-1419.344-235.564L-1084.405-339.362-1315.532-667.867C-1374.923-752.281-1354.938-868.82-1270.815-928.623L-1261.439-935.288C-1178.944-993.933-1064.797-976.535-1003.521-895.976L-767.711-585.962-541.063-892.492C-480.298-974.675-364.915-993.064-281.613-933.843L-273.759-928.26C-189.839-868.599-169.717-752.434-228.682-668.023L-458.266-339.362-123.327-235.564C-24.036-204.793 31.282-99.131 0 0"/>
</g>
</g>
</g>
</symbol>
  </svg>

  <header class="site-header">
    <div class="site-header-inner">
      <a href="{{ '/' | url }}" class="site-brand" aria-label="every*one — Adelaide Design Week home">
        <img src="{{ '/assets/images/everyone-pill.svg' | url }}" alt="every*one" width="2057" height="421">
      </a>
      {% include "nav.njk" %}
    </div>
  </header>

  <main class="site-main">
    {{ content | safe }}
  </main>

  {% if lightbox %}
  <script src="{{ '/assets/js/lightbox.js' | url }}" defer></script>
  {% endif %}

  {% if copyButtons %}
  <script src="{{ '/assets/js/copy-buttons.js' | url }}" defer></script>
  {% endif %}

  <footer class="site-footer">
    <div class="site-footer-inner">
      <a href="{{ '/' | url }}" class="footer-lockup" aria-label="every*one — Adelaide Design Week">
        <img src="{{ '/assets/images/everyone-stacked.svg' | url }}" alt="" width="2055" height="532">
      </a>
      <p class="acknowledgment">{{ site.acknowledgment }}</p>
      <p class="copyright">
        <svg class="ast ast--sm" aria-hidden="true"><use href="#ast"></use></svg>
        &copy; Adelaide Design Week {{ site.year }}
      </p>
    </div>
  </footer>

</body>
</html>
