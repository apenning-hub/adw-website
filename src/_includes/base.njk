<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ECEFE8">
  <title>{% if title %}{{ title }} — {{ site.shortTitle }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  {%- if env.preview or noindex %}
  {# Preview builds, plus pages meant only for people given the URL. #}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}?v={{ assets.css }}">
  {%- if map %}
  <link rel="stylesheet" href="{{ '/assets/css/mapbox-gl.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/map.css' | url }}?v={{ assets.mapCss }}">
  {%- endif %}
  {% if tallyPopup %}
  <script>
    window.TallyConfig = {
      "formId": "5BllMv",
      "popup": {
        "autoClose": 5000,
        "formEventsForwarding": true,
        "open": {
          "trigger": "scroll",
          "scrollPercent": 25
        }
      }
    };
  </script>
  <script async src="https://tally.so/widgets/embed.js"></script>
  {% endif %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

  <svg class="brand-sprite" aria-hidden="true" focusable="false" width="0" height="0">
    <symbol id="ast" viewBox="0 0 1560.16 1568.69"><defs>
