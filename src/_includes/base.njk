-38.184-170.385H66.352L124.383 112.329 153.36-87.17H278.641L400.955 122.015 438.71-87.17H564.622L749.963 249.818Z"/>
</g>
</g>
</g>
</symbol>
  </svg>

  <header class="site-header">
    <div class="site-header-inner">
      <a href="{{ '/' | url }}" class="site-brand" aria-label="every*one — Adelaide Design Week home">
        <img src="{{ '/assets/images/everyone-pill.svg' | url }}" alt="every*one" width="2057" height="421">
      </a>
      {% include "nav.njk" %}
    </div>
  </header>

  <main class="site-main">
    {{ content | safe }}
  </main>

  {% if lightbox %}
  <script src="{{ '/assets/js/lightbox.js' | url }}" defer></script>
  {% endif %}

  {% if map %}
  {# Mapbox GL is served from this origin, pinned by package-lock.json.
     map-style.js must run before map.js, which reads ADWMapStyle on load. #}
  <script src="{{ '/assets/js/mapbox-gl.js' | url }}" defer></script>
  <script src="{{ '/assets/js/map-style.js' | url }}?v={{ assets.mapStyleJs }}" defer></script>
  <script src="{{ '/assets/js/map.js' | url }}?v={{ assets.mapJs }}" defer></script>
  {% endif %}

  {% if updatesForm %}
  <script async src="https://tally.so/widgets/embed.js"></script>
  <script src="{{ '/assets/js/program-updates.js' | url }}?v={{ assets.updatesJs }}" defer></script>
  {% endif %}

  {% if copyButtons %}
  <script src="{{ '/assets/js/copy-buttons.js' | url }}" defer></script>
  {% endif %}

  <footer class="site-footer">
    <div class="site-footer-inner">
      <a href="{{ '/' | url }}" class="footer-lockup" aria-label="every*one — Adelaide Design Week">
        <img src="{{ '/assets/images/everyone-stacked.svg' | url }}" alt="" width="2055" height="532">
      </a>
      <p class="acknowledgment">{{ site.acknowledgment }}</p>
      <p class="copyright">
        <svg class="ast ast--sm" aria-hidden="true"><use href="#ast"></use></svg>
        &copy; Adelaide Design Week {{ site.year }}
      </p>
    </div>
  </footer>

</body>
</html>
