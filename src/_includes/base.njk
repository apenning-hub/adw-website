</g>
</symbol>
    <symbol id="adw" viewBox="0 0 1526.09 699.408"><defs>
<clipPath id="adw_clip">
<path transform="matrix(1,0,0,-1,0,699.408)" d="M0 699.408H1526.091V0H0Z"/>
</clipPath>
</defs>
<g fill="currentColor">
<g inkscape:groupmode="layer" inkscape:label="Layer 1">
