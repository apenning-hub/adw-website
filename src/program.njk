---
title: Program
navLabel: program
navOrder: 2
permalink: /program/
layout: base.njk
description: The every*one program — Adelaide Design Week 2026. Exhibitions, installations, conversations, open studios, tours and workshops across Kaurna/Adelaide, 14–18 October 2026.
---

<header class="pg-head">
<h1 class="pg-h1">Program</h1>
<p class="pg-intro">{{ program2026.count }} events across Adelaide, {{ site.programDates | lower }} — plus previews from 8 October. Exhibitions, installations, conversations, open studios, tours and workshops.</p>
<p class="pg-note"><span class="pg-tick" aria-hidden="true">*</span> marks a ticketed event.</p>
</header>

<section class="pg" aria-label="2026 program">

  <div class="pg-controls">
    <div class="pg-views" role="tablist" aria-label="view">
      <button class="pg-view is-on" role="tab" aria-selected="true" data-view="day">by day</button>
      <button class="pg-view" role="tab" aria-selected="false" data-view="az">a–z</button>
    </div>

    <div class="pg-days" data-days hidden>
      {% for d in program2026.byDay %}
      <button class="pg-daybtn{% if loop.first %} is-on{% endif %}" data-day="{{ d.day }}">{{ d.day }}</button>
      {% endfor %}
    </div>

    <div class="pg-filters" data-filters hidden>
      <button class="pg-chip is-on" data-cat="all">all</button>
      {% for code, label in program2026.categories %}
      <button class="pg-chip" data-cat="{{ code }}">{{ label }}</button>
      {% endfor %}
    </div>
  </div>

  {#- Every day is rendered as a plain section. JavaScript turns these into
      tab panels; without it the page is simply the whole program, readable
      top to bottom. -#}
  <div class="pg-panel" data-panel="day">
    {% for d in program2026.byDay %}
    <section class="pg-day" data-day="{{ d.day }}">
      <h2 class="pg-dayhead">{{ d.day }}<span class="pg-daycount">{{ d.events | length }}</span></h2>
      <ul class="pg-list">
        {% for e in d.events %}
        <li class="pg-item" data-cat="{{ e.category }}">
          <details class="pg-event" id="{{ d.day | replace(' ','-') }}-{{ e.slug }}">
            <summary class="pg-sum">
              <span class="pg-cat" title="{{ e.categoryLabel }}">{{ e.category }}</span>
              <span class="pg-title">{{ e.title }}{% if e.ticketed %}<span class="pg-tick" title="ticketed"> *</span>{% endif %}</span>
              <span class="pg-time">{% for t in e.times %}{{ t }}{% if not loop.last %} <span class="pg-sep">/</span> {% endif %}{% endfor %}</span>
            </summary>
            <div class="pg-body">
              <dl class="pg-meta">
                <dt>where</dt><dd>{{ e.venue }}</dd>
                <dt>what</dt><dd>{{ e.categoryLabel }}{% if e.ticketed %} · ticketed{% endif %}</dd>
                <dt>when</dt>
                <dd><ul class="pg-when">
                  {% for s in e.sessions %}
                  <li{% if s.day == d.day %} class="is-today"{% endif %}><span>{{ s.day }}</span> {{ s.times | join(" / ") }}</li>
                  {% endfor %}
                </ul></dd>
              </dl>
              {% if e.blurb %}<p class="pg-blurb">{{ e.blurb }}</p>{% endif %}
              {% if e.link %}<p class="pg-link"><a href="{{ e.link }}" target="_blank" rel="noopener noreferrer">more information →</a></p>{% endif %}
            </div>
          </details>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endfor %}
  </div>

  <div class="pg-panel" data-panel="az" hidden>
    <h2 class="pg-dayhead">a–z<span class="pg-daycount">{{ program2026.count }}</span></h2>
    <ul class="pg-list">
      {% for e in program2026.az %}
      <li class="pg-item" data-cat="{{ e.category }}">
        <details class="pg-event" id="az-{{ e.slug }}">
          <summary class="pg-sum">
            <span class="pg-cat" title="{{ e.categoryLabel }}">{{ e.category }}</span>
            <span class="pg-title">{{ e.title }}{% if e.ticketed %}<span class="pg-tick" title="ticketed"> *</span>{% endif %}</span>
            <span class="pg-time pg-venue-inline">{{ e.venue }}</span>
          </summary>
          <div class="pg-body">
            <dl class="pg-meta">
              <dt>where</dt><dd>{{ e.venue }}</dd>
              <dt>what</dt><dd>{{ e.categoryLabel }}{% if e.ticketed %} · ticketed{% endif %}</dd>
              <dt>when</dt>
              <dd><ul class="pg-when">
                {% for s in e.sessions %}<li><span>{{ s.day }}</span> {{ s.times | join(" / ") }}</li>{% endfor %}
              </ul></dd>
            </dl>
            {% if e.blurb %}<p class="pg-blurb">{{ e.blurb }}</p>{% endif %}
            {% if e.link %}<p class="pg-link"><a href="{{ e.link }}" target="_blank" rel="noopener noreferrer">more information →</a></p>{% endif %}
          </div>
        </details>
      </li>
      {% endfor %}
    </ul>
  </div>

  <p class="pg-empty" data-empty hidden>Nothing in that category on this day.</p>
</section>

<script src="{{ '/assets/js/program.js' | url }}" defer></script>
