# Adelaide Design Week — local build secrets
#
#   cp .env.example .env     then fill in the values below
#
# .env is gitignored and never leaves this machine. Nothing here is read by
# a Cloudflare build: the map is local-only for now (see src/map.11tydata.js),
# and the geocoding and thumbnail scripts are run by hand.
#
# Tokens are made at https://account.mapbox.com/access-tokens/


# BROWSER token — starts pk.
# The only one that reaches a visitor. Safe to URL-restrict, and it should be.
#
# Restrict it to every host this site answers on, or the map 403s for anyone
# who arrives on the "wrong" one. All three of these serve the site:
#     https://adelaidedesignweek.com.au/*
#     https://www.adelaidedesignweek.com.au/*
#     https://everyone.adelaidedesignweek.com.au/*
# and add this one so the map works while you are building it:
#     http://localhost:8080/*
MAPBOX_PUBLIC_TOKEN=

# BUILD token — starts pk., NO URL restriction.
# Used by the geocoding and thumbnail scripts, which run from a terminal and
# therefore send no Referer header. A URL-restricted token can never satisfy
# a restriction it has no way to present, so this one must be unrestricted.
# It never reaches a browser and is never committed.
MAPBOX_BUILD_TOKEN=

# SECRET token — starts sk.
# Used once, by scripts/publish-map-style.js, to upload the basemap style to
# your Mapbox account. Needs the scopes styles:write and styles:read.
# Secret tokens cannot be URL-restricted, which is why this one just works.
MAPBOX_SECRET_TOKEN=

# Only needed if the username cannot be read out of the secret token.
# MAPBOX_USERNAME=
